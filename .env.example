# ==============================================================
# LLM Provider Configuration
# Choose your preferred provider: 'gemini', 'groq', or 'openai'
# ==============================================================
LLM_PROVIDER=gemini

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fast & Free tier at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (or compatible local endpoint like Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding model (Hugging Face sentence-transformers model run locally on CPU)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
